# LLM Provider Configuration
# "local" = LM Studio / Ollama (OpenAI-compatible API)
# "browser_use" = Browser Use cloud API (requires BROWSER_USE_API_KEY)
LLM_PROVIDER=local

# Local LLM server settings (used when LLM_PROVIDER=local)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=bu-30b-a3b-preview
LLM_HEALING_MODEL=bu-30b-a3b-preview

# Browser Use cloud API (only needed if LLM_PROVIDER=browser_use)
# BROWSER_USE_API_KEY=

# Legacy keys (for direct OpenAI/Groq usage if desired)
# OPENAI_API_KEY=
# GROQ_API_KEY=
