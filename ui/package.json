{
  "name": "workflow-use-ui",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "get-openapi": "curl http://localhost:${BACKEND_PORT:-8000}/openapi.json -o ./src/lib/api/openapi.json",
    "type-gen": "npx openapi-typescript ./src/lib/api/openapi.json -o ./src/lib/api/apigen.d.ts",
    "type-gen-update": "rm -rf ./src/lib/api/apigen.d.ts && npm run get-openapi && npm run type-gen",
    "postinstall": "test -n \"$NOYARNPOSTINSTALL\" || npm run type-gen"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.7",
    "@xyflow/react": "12.6.4",
    "openapi-fetch": "0.14.0",
    "openapi-react-query": "0.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.7",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.15.19",
    "@types/react": "18.3.21",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.20",
    "openapi-typescript": "7.8.0",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "tar": "7.5.21",
    "rollup": "4.62.2",
    "@babel/core": "7.29.6",
    "ajv@6": "6.14.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "js-yaml": "4.3.1",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "picomatch@2": "2.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "flatted": "3.4.2"
  }
}
